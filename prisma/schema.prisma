// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                       String                   @id @default(cuid())
  email                    String                   @unique
  password                 String
  name                     String?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  fundAllocation           FundAllocation?
  incomeEntries            IncomeEntry[]
  accounts                 Account[]
  transfers                Transfer[]
  expenses                 Expense[]
  recurringExpenses        RecurringExpense[]
  subscriptions            Subscription[]
  loans                    Loan[]
  borrowedLoans            BorrowedLoan[]
  categoryBalances         CategoryBalance[]
  categoryTransactions     CategoryTransaction[]
  investmentHoldings       InvestmentHolding[]
  investmentDividends      InvestmentDividend[]
  categoryMonthClosings    CategoryMonthClosing[]
  savingGoals              SavingGoal[]
  savingGoalCredits        SavingGoalCredit[]
  categoryBucketTransfers  CategoryBucketTransfer[]
  apiTokens                ApiToken[]
  netWorthSnapshots        NetWorthSnapshot[]
  basiqConnections         BasiqConnection[]
  superannuationAccounts   SuperannuationAccount[]
  superContributions       SuperannuationContribution[]
  defaultAccountId         String?
  /// "classic" | "console" — which dashboard experience to load by default
  dashboardTheme           String                   @default("console")
  /// ISO 4217 code — ledger amounts are stored in minor units of this currency
  displayCurrency          String                   @default("AUD")
  /// Set when the user finishes first-time setup (accounts + bucket splits).
  onboardingCompletedAt    DateTime?
  /// Set when the user saves bucket splits during onboarding (even if still default %).
  onboardingBucketsSavedAt DateTime?
  /// Set when the user finishes the in-app spotlight product tour.
  productTourCompletedAt   DateTime?
}

/// Personal access token for external integrations (e.g. Apple Shortcuts).
/// Plaintext is persisted so the user can always copy it later. `tokenHash`
/// is retained for O(1) indexed lookup in the auth path.
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String // user-visible label, e.g. "iPhone Shortcut"
  token      String? // plaintext token; null only for legacy rows created before plaintext was kept
  tokenHash  String    @unique // sha256 of full token secret — used for bearer lookup
  prefix     String // first ~10 chars of the plaintext, for display (e.g. "csp_abcdef")
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  @@index([userId])
}

model FundAllocation {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Allocation types: 'percentage' or 'fixed'
  fixedCostsType       String  @default("percentage")
  fixedCostsPercentBps Int     @default(5000) // 10000 = 100%, 5000 = 50%
  fixedCostsFixedMinor BigInt? // Used when fixedCostsType = 'fixed'
  fixedCostsCap        BigInt? // Optional cap in minor units (null = no cap)

  savingsType       String  @default("percentage")
  savingsPercentBps Int     @default(2000)
  savingsFixedMinor BigInt?
  savingsCap        BigInt?

  investmentType       String  @default("percentage")
  investmentPercentBps Int     @default(1000)
  investmentFixedMinor BigInt?
  investmentCap        BigInt?

  guiltFreeSpendingType       String  @default("percentage")
  guiltFreeSpendingPercentBps Int     @default(2000)
  guiltFreeSpendingFixedMinor BigInt?
  guiltFreeSpendingCap        BigInt?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IncomeEntry {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount                BigInt
  description           String? // Optional description for the income entry
  date                  DateTime @default(now()) // Date when income was received
  periodStart           DateTime
  periodEnd             DateTime
  accountId             String? // Account where income was deposited
  account               Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdAt             DateTime @default(now())
  excludeFromAllocation Boolean  @default(false) // If true, this income is not used for fund allocation / budgets

  // Amount allocated to each category when this entry was added (used to reverse on delete)
  allocationFixedCosts        BigInt?
  allocationSavings           BigInt?
  allocationInvestment        BigInt?
  allocationGuiltFreeSpending BigInt?

  /// When set, this row was created for an investment dividend (one-to-one).
  investmentDividend InvestmentDividend?
  savingGoalCredits  SavingGoalCredit[]
  externalId            String?
  source                String   @default("manual")

  @@index([userId])
  @@index([accountId])
  @@unique([userId, externalId])
}

model Account {
  id                  String               @id @default(cuid())
  userId              String
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  bankName            String
  accountType         String // e.g., "checking", "savings", "investment", "credit"
  balance             BigInt               @default(0)
  startingFunds       BigInt               @default(0)
  isDefault           Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  basiqAccountId      String?
  lastSyncedAt        DateTime?
  outgoingTransfers   Transfer[]           @relation("FromAccount")
  incomingTransfers   Transfer[]           @relation("ToAccount")
  expenses            Expense[]
  recurringExpenses   RecurringExpense[]
  incomeEntries       IncomeEntry[]
  investmentHoldings  InvestmentHolding[]
  investmentDividends InvestmentDividend[]
  loans               Loan[]
  borrowedLoans       BorrowedLoan[]

  @@index([userId])
}

model Transfer {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromAccountId String
  fromAccount   Account  @relation("FromAccount", fields: [fromAccountId], references: [id], onDelete: Cascade)
  toAccountId   String
  toAccount     Account  @relation("ToAccount", fields: [toAccountId], references: [id], onDelete: Cascade)
  amount        BigInt
  description   String?
  category      String? // Fund category: 'fixedCosts', 'investment', 'savings', 'guiltFreeSpending'
  date          DateTime @default(now()) // Date when transfer occurred
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([fromAccountId])
  @@index([toAccountId])
  @@index([userId, category])
}

model CategoryBalance {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String // 'fixedCosts', 'savings', 'investment', 'guiltFreeSpending'
  balance   BigInt   @default(0) // Accumulated amount in minor units for this category for the current month
  month     Int // Month (1-12)
  year      Int // Year
  updatedAt DateTime @updatedAt

  @@unique([userId, category, month, year])
  @@index([userId])
  @@index([userId, month, year])
}

model CategoryMonthClosing {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String // 'fixedCosts', 'savings', 'investment', 'guiltFreeSpending'
  month     Int // Month (1-12)
  year      Int
  remaining BigInt   @default(0) // Carryover to next month in minor units (>= 0)
  overspent BigInt   @default(0) // Amount to deduct from next month in minor units (>= 0)
  updatedAt DateTime @updatedAt

  @@unique([userId, category, month, year])
  @@index([userId])
  @@index([userId, month, year])
}

model Expense {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId       String
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  amount          BigInt
  description     String?
  category        String? // Fund category: 'fixedCosts', 'investment', 'savings', 'guiltFreeSpending'
  expenseCategory String? // Expense category: 'food', 'transport', 'bills', 'entertainment', etc.
  date            DateTime // Date of the expense
  createdAt       DateTime @default(now())
  externalId      String?
  source          String   @default("manual")
  syncStatus      String   @default("confirmed")

  @@index([userId])
  @@index([accountId])
  @@index([userId, date])
  @@index([userId, expenseCategory])
  @@unique([userId, externalId])
}

model RecurringExpense {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId       String
  account         Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  amount          BigInt
  description     String?
  category        String?
  expenseCategory String?
  frequency       String // 'weekly', 'monthly', 'yearly'
  startDate       DateTime      @default(now())
  endDate         DateTime?
  isActive        Boolean       @default(true)
  lastRunAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  subscription    Subscription?

  @@index([userId])
  @@index([accountId])
}

/// Recurring charge tracked as a subscription (1:1 with RecurringExpense for billing).
model Subscription {
  id                 String           @id @default(cuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurringExpenseId String           @unique
  recurringExpense   RecurringExpense @relation(fields: [recurringExpenseId], references: [id], onDelete: Cascade)
  provider           String?
  label              String?
  status             String           @default("active") // active | paused | cancelled
  trialEndsAt        DateTime?
  nextRenewalAt      DateTime?
  reminderDaysBefore Int              @default(7)
  foreignCurrency    String? // null if local currency, e.g. "USD" if foreign
  foreignAmount      BigInt? // original amount in foreign currency minor units
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([userId])
  @@index([userId, status])
}

model CategoryTransaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    String // 'fixedCosts', 'savings', 'investment', 'guiltFreeSpending'
  type        String // 'expense' or 'income'
  amount      BigInt
  description String?
  date        DateTime
  month       Int // Month (1-12) for tracking
  year        Int // Year for tracking
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([userId, category, month, year])
  @@index([userId, date])
}

model InvestmentHolding {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name           String // Name of the share / fund / asset
  amount         BigInt // Total invested in minor units including brokerage fees
  pricePerUnit   BigInt? // Price per share/unit in minor units
  numberOfShares Decimal? @db.Decimal(24, 8) // Share count as exact decimal (not float)
  brokerageFee   BigInt? // Optional brokerage fee in minor units
  date           DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([accountId])
  @@index([userId, name])
}

/// Cash dividend received on a stock / fund — credited to the investment account balance.
model InvestmentDividend {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId     String
  account       Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name          String // Symbol / ticker (matches InvestmentHolding.name for the same line)
  amount        BigInt
  date          DateTime     @default(now())
  createdAt     DateTime     @default(now())
  /// Mirrors this dividend on the income ledger (statement); cascades when income row is deleted.
  incomeEntryId String?      @unique
  incomeEntry   IncomeEntry? @relation(fields: [incomeEntryId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([accountId])
  @@index([userId, name])
}

model Loan {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId    String
  account      Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  amount       BigInt
  description  String?
  borrowerName String?
  date         DateTime  @default(now())
  dueDate      DateTime?
  status       String    @default("active") // 'active', 'repaid', 'defaulted'
  repaidAmount BigInt    @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@index([accountId])
  @@index([userId, status])
}

model BorrowedLoan {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId    String
  account      Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  amount       BigInt
  description  String?
  lenderName   String?
  date         DateTime  @default(now())
  dueDate      DateTime?
  status       String    @default("active") // 'active', 'repaid', 'defaulted'
  repaidAmount BigInt    @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@index([accountId])
  @@index([userId, status])
}

/// Named saving goal — auto-credits a % of each income's savings-bucket allocation.
model SavingGoal {
  id           String             @id @default(cuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  targetMinor  BigInt?
  currentMinor BigInt             @default(0)
  percentBps   Int // % of savings-bucket allocation (1000 = 10%)
  status       String             @default("active") // active | complete | archived
  completedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  credits      SavingGoalCredit[]

  @@index([userId, status])
}

/// Ledger row crediting a saving goal from a specific income entry.
model SavingGoalCredit {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  savingGoalId  String
  savingGoal    SavingGoal  @relation(fields: [savingGoalId], references: [id], onDelete: Cascade)
  incomeEntryId String
  incomeEntry   IncomeEntry @relation(fields: [incomeEntryId], references: [id], onDelete: Cascade)
  amountMinor   BigInt
  createdAt     DateTime    @default(now())

  @@unique([savingGoalId, incomeEntryId])
  @@index([userId])
  @@index([incomeEntryId])
}

/// Plan-level move between fund buckets (Category Tracking envelope transfer).
model CategoryBucketTransfer {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromCategory String // fixedCosts | savings | investment | guiltFreeSpending
  toCategory   String
  amount       BigInt
  month        Int
  year         Int
  createdAt    DateTime @default(now())

  @@index([userId, month, year])
  @@index([userId, createdAt])
}

model NetWorthSnapshot {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month           Int
  year            Int
  cashValue       BigInt   @default(0)
  investmentValue BigInt   @default(0)
  loanValue       BigInt   @default(0)
  superValue      BigInt   @default(0)
  netWorth        BigInt   @default(0)
  recordedAt      DateTime @default(now())

  @@unique([userId, month, year])
  @@index([userId])
}

model SuperannuationAccount {
  id            String                      @id @default(cuid())
  userId        String
  user          User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String // e.g. "AustralianSuper", "REST Super"
  fundType      String? // e.g. "Balanced", "Growth", "High Growth"
  provider      String? // Fund provider / trustee
  memberNumber  String?
  employerName  String?
  balance       BigInt                      @default(0) // Current balance in minor units
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt
  contributions SuperannuationContribution[]

  @@index([userId])
}

model SuperannuationContribution {
  id              String                @id @default(cuid())
  userId          String
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  superAccountId  String
  superAccount    SuperannuationAccount @relation(fields: [superAccountId], references: [id], onDelete: Cascade)
  amount          BigInt
  type            String // "employer", "salary_sacrifice", "personal", "government"
  date            DateTime              @default(now())
  description     String?
  createdAt       DateTime              @default(now())

  @@index([userId])
  @@index([superAccountId])
  @@index([userId, date])
}

model BasiqConnection {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  basiqUserId     String
  connectionId    String
  institutionId   String
  institutionName String
  status          String   @default("active")
  connectedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, connectionId])
  @@index([userId])
}
